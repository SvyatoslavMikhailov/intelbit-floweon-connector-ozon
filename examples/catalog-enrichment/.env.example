# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=
# Базовый URL Ozon (менять не нужно для прода)
OZON_BASE_URL=https://api-seller.ozon.ru

# 1С-Битрикс БУС — входящий webhook (без конечного метода):
#   http://host/rest/USER_ID/TOKEN
# Права webhook: scope `catalog` (disk/iblock-запись в БУС не используются).
# Локальный стенд по HTTP: в dbconn.php задать define('REST_APAUTH_ALLOW_HTTP', true).
VITRINA_WEBHOOK_URL=
# ID инфоблока каталога (должен быть зарегистрирован как коммерческий каталог)
VITRINA_IBLOCK_ID=
# VITRINA_STORAGE_ID больше не нужен: БУС не использует disk-модуль,
# картинки грузятся через catalog.productImage.add.
